{
  "manifest_version": 3,
  "name": "Intercom Enhancer",
  "description": "Record and send voice messages to customers straight from the Intercom Help Desk.",
  "version": "1.4.0",
  "icons": {
    "16": "assets/icons/16.png",
    "32": "assets/icons/32.png",
    "64": "assets/icons/64.png",
    "128": "assets/icons/128.png",
    "256": "assets/icons/256.png",
    "512": "assets/icons/512.png"
  },
  "content_scripts": [
    {
      "matches": ["https://app.intercom.com/*"],
      "js": ["./vendor/lame.min.js", "./content.js"]
    }
  ]
}
